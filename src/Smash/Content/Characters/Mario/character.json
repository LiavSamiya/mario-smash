{
  // speeds are in world pixels per tick (60 ticks per second); hitbox radii are in world pixels
  // the animations are in frames.json, which is generated by tools/SpriteCutter
  "name": "Mario",
  "order": 0,
  "scale": 2.4,
  "weight": 90,
  "runSpeed": 5.8,
  "groundAcceleration": 1.0,
  "groundFriction": 0.7,
  "airSpeed": 4.6,
  "airAcceleration": 0.5,
  "airFriction": 0.08,
  "gravity": 0.55,
  "maxFallSpeed": 9.5,
  "fastFallSpeed": 14,
  "jumpVelocity": 12.5,
  "shortHopVelocity": 8.5,
  "doubleJumpVelocity": 11.5,
  "jumpSquatTicks": 3,
  "landingTicks": 5,

  // angle: 0 = forward, 90 = straight up, 361 = low knockback stays horizontal, strong knockback launches at 40 degrees
  "moves": {
    "Jab":        { "animation": "Jab", "followUp": "MultiJab", "hits": [
      { "frames": [1, 2], "damage": 3, "angle": 361, "baseKnockback": 20, "knockbackGrowth": 40, "hitbox": { "direction": "Forward", "radius": 18 } } ] },
    "MultiJab":   { "animation": "MultiJab", "hits": [
      { "frames": [0, 0], "damage": 2, "angle": 361, "baseKnockback": 15, "knockbackGrowth": 30, "hitbox": { "direction": "Forward", "radius": 18 } },
      { "frames": [3, 5], "damage": 2, "angle": 361, "baseKnockback": 15, "knockbackGrowth": 30, "hitbox": { "direction": "Forward", "radius": 20 } },
      { "frames": [9, 11], "damage": 7, "angle": 40, "baseKnockback": 45, "knockbackGrowth": 90, "hitbox": { "direction": "Forward", "radius": 24 } } ] },
    "UpTilt":     { "animation": "UpTilt", "hits": [
      { "frames": [1, 1], "damage": 5, "angle": 80, "baseKnockback": 35, "knockbackGrowth": 60, "hitbox": { "direction": "Forward", "radius": 20 } },
      { "frames": [2, 3], "damage": 6, "angle": 85, "baseKnockback": 30, "knockbackGrowth": 110, "hitbox": { "direction": "UpForward", "radius": 22 } } ] },
    "UpSmash":    { "animation": "UpSmash", "hits": [
      { "frames": [1, 3], "damage": 15, "angle": 88, "baseKnockback": 32, "knockbackGrowth": 98, "hitbox": { "direction": "Around", "radius": 24 } } ] },
    "DownSmash":  { "animation": "DownSmash", "hits": [
      { "frames": [1, 2], "damage": 12, "angle": 25, "baseKnockback": 30, "knockbackGrowth": 100, "hitbox": { "direction": "Sides", "radius": 22 } },
      { "frames": [4, 5], "damage": 14, "angle": 30, "baseKnockback": 32, "knockbackGrowth": 102, "hitbox": { "direction": "Sides", "radius": 22 } } ] },
    "NeutralAir": { "animation": "NeutralAir", "aerial": true, "landingLag": 6, "hits": [
      { "frames": [1, 2], "damage": 8, "angle": 361, "baseKnockback": 12, "knockbackGrowth": 100, "hitbox": { "direction": "Forward", "radius": 22 } } ] },
    "UpAir":      { "animation": "UpAir", "aerial": true, "landingLag": 6, "hits": [
      { "frames": [2, 4], "damage": 7, "angle": 85, "baseKnockback": 20, "knockbackGrowth": 120, "hitbox": { "direction": "Up", "radius": 20 } } ] }
  }
}
